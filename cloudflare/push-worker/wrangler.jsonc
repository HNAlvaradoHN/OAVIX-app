{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oavix-push",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://hnalvaradohn.github.io",
    "VAPID_SUBJECT": "https://hnalvaradohn.github.io/OAVIX-app/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oavix-push",
      "database_id": "f09daf5a-cd18-4cdc-80f8-24c98dd906eb"
    }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
